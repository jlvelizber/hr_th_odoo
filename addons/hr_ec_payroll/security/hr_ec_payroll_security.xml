<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hr_ec_payroll_period_company" model="ir.rule">
        <field name="name">Períodos nómina: multi-compañía</field>
        <field name="model_id" ref="model_hr_ec_payroll_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_hr_ec_payroll_input_company" model="ir.rule">
        <field name="name">Novedades nómina: multi-compañía</field>
        <field name="model_id" ref="model_hr_ec_payroll_input"/>
        <field name="domain_force">[('period_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
