<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_ec_payroll_period_graph" model="ir.ui.view">
        <field name="name">hr.ec.payroll.period.graph</field>
        <field name="model">hr.ec.payroll.period</field>
        <field name="arch" type="xml">
            <graph string="Períodos por estado" type="bar">
                <field name="state" type="row"/>
            </graph>
        </field>
    </record>

    <record id="view_hr_ec_payroll_input_pivot" model="ir.ui.view">
        <field name="name">hr.ec.payroll.input.pivot</field>
        <field name="model">hr.ec.payroll.input</field>
        <field name="arch" type="xml">
            <pivot string="Novedades">
                <field name="partner_id" type="row"/>
                <field name="input_type_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_hr_ec_payroll_analysis" model="ir.actions.act_window">
        <field name="name">Análisis nómina</field>
        <field name="res_model">hr.ec.payroll.input</field>
        <field name="view_mode">pivot,tree,form</field>
    </record>

    <menuitem id="menu_hr_ec_payroll_analysis" name="Análisis" parent="menu_hr_ec_payroll_root" action="action_hr_ec_payroll_analysis" sequence="30"/>
</odoo>
