<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_ec_payroll" model="ir.ui.view">
        <field name="name">res.company.form.ec.payroll</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Nómina Ecuador (TH)" groups="hr_service_management.group_hr_th_manager">
                    <group>
                        <field name="th_ec_iess_employee_rate"/>
                        <field name="th_ec_iess_employer_rate"/>
                    </group>
                    <field name="th_ec_payroll_legal_notes" placeholder="Referencias normativas acordadas con asesoría..."/>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
