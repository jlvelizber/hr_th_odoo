<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_applicant_form_th" model="ir.ui.view">
        <field name="name">hr.applicant.form.th</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_schedule_interview" string="Programar entrevista" type="object" class="btn-secondary"/>
            </xpath>
            <field name="job_id" position="after">
                <field name="client_partner_id"/>
            </field>
            <notebook position="inside">
                <page string="Evaluación TH">
                    <group>
                        <field name="th_interview_score"/>
                        <field name="th_interview_notes"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

    <record id="action_th_applicants" model="ir.actions.act_window">
        <field name="name">Candidatos de clientes</field>
        <field name="res_model">hr.applicant</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('client_partner_id', '!=', False)]</field>
    </record>
</odoo>
