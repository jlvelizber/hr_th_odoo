<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_job_profile_template_tree" model="ir.ui.view">
        <field name="name">hr.job.profile.template.tree</field>
        <field name="model">hr.job.profile.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_job_profile_template_form" model="ir.ui.view">
        <field name="name">hr.job.profile.template.form</field>
        <field name="model">hr.job.profile.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group string="Contenido">
                        <field name="description" colspan="2"/>
                        <field name="requirements" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Tareas del proceso">
                            <field name="task_line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_job_profile_template" model="ir.actions.act_window">
        <field name="name">Perfiles plantilla</field>
        <field name="res_model">hr.job.profile.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
