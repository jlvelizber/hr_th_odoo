<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_sri_th" model="ir.ui.view">
        <field name="name">res.company.form.sri.th</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="SRI (TH)" groups="account.group_account_manager">
                    <group>
                        <field name="sri_th_enabled"/>
                        <field name="sri_th_ambiente"/>
                        <field name="sri_th_emission_type"/>
                        <field name="sri_th_certificate_note"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
