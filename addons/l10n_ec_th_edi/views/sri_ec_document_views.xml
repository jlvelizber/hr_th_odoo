<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sri_ec_document_tree" model="ir.ui.view">
        <field name="name">sri.ec.document.tree</field>
        <field name="model">sri.ec.document</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="move_id"/>
                <field name="partner_id"/>
                <field name="access_key"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_sri_ec_document_form" model="ir.ui.view">
        <field name="name">sri.ec.document.form</field>
        <field name="model">sri.ec.document</field>
        <field name="arch" type="xml">
            <form string="Comprobante SRI">
                <header>
                    <button name="action_prepare_draft_xml" string="Preparar XML" type="object" invisible="state != 'draft'"/>
                    <button name="action_mark_signed" string="Marcar firmado" type="object" invisible="state != 'xml_ready'"/>
                    <button name="action_simulate_send" string="Enviar (simulacion)" type="object" invisible="state != 'signed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="move_id"/>
                        <field name="access_key"/>
                    </group>
                    <group string="Mensajes">
                        <field name="reception_message"/>
                        <field name="authorization_message"/>
                    </group>
                    <field name="xml_unsigned" widget="text"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_sri_ec_document" model="ir.actions.act_window">
        <field name="name">Comprobantes SRI</field>
        <field name="res_model">sri.ec.document</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
