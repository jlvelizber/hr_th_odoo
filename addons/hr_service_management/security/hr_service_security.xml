<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_th_services" model="ir.module.category">
        <field name="name">Servicios TH</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_hr_th_user" model="res.groups">
        <field name="name">Usuario TH</field>
        <field name="category_id" ref="module_category_hr_th_services"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user')), (4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_hr_th_manager" model="res.groups">
        <field name="name">Responsable TH</field>
        <field name="category_id" ref="module_category_hr_th_services"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_th_user')), (4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_hr_th_payroll" model="res.groups">
        <field name="name">Nómina TH</field>
        <field name="category_id" ref="module_category_hr_th_services"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_th_user'))]"/>
    </record>

    <record id="group_hr_th_commercial" model="res.groups">
        <field name="name">Comercial TH</field>
        <field name="category_id" ref="module_category_hr_th_services"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>
