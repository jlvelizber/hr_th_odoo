<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_service_contract_tree" model="ir.ui.view">
        <field name="name">hr.service.contract.tree</field>
        <field name="model">hr.service.contract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="service_kind"/>
                <field name="service_mode"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="date_start"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_service_contract_kanban" model="ir.ui.view">
        <field name="name">hr.service.contract.kanban</field>
        <field name="model">hr.service.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <strong><field name="name"/></strong>
                            <div><field name="partner_id"/></div>
                            <div><field name="product_id"/></div>
                            <div class="text-muted"><field name="user_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hr_service_contract_form" model="ir.ui.view">
        <field name="name">hr.service.contract.form</field>
        <field name="model">hr.service.contract</field>
        <field name="arch" type="xml">
            <form string="Contrato de servicio">
                <header>
                    <button name="action_confirm" string="Activar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_create_project" string="Generar proyecto operativo" type="object" invisible="state != 'active' or project_id or service_kind == 'payroll'"/>
                    <button name="action_open_payroll_period_wizard" string="Nuevo período de nómina" type="object" invisible="state != 'active' or service_kind != 'payroll'"/>
                    <button name="action_create_sale_order" string="Crear pedido de venta" type="object" invisible="state != 'active' or sale_order_id"/>
                    <button name="action_done" string="Finalizar" type="object" invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancelar" type="object" invisible="state in ('done', 'cancel')"/>
                    <button name="action_draft" string="Volver a borrador" type="object" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_project" class="oe_stat_button" icon="fa-tasks" invisible="not project_id">
                            <span class="o_stat_text">Proyecto</span>
                        </button>
                        <button type="object" name="action_view_payroll_projects" class="oe_stat_button" icon="fa-calendar" invisible="service_kind != 'payroll'">
                            <span class="o_stat_text">Nóminas</span>
                        </button>
                        <button type="object" name="action_open_sale_order" class="oe_stat_button" icon="fa-shopping-cart" invisible="not sale_order_id">
                            <span class="o_stat_text">Venta</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="product_id"/>
                            <field name="service_kind"/>
                            <field name="service_mode"/>
                            <field name="periodicity"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="price_unit"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="sale_order_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Observaciones">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hr_service_contract_search" model="ir.ui.view">
        <field name="name">hr.service.contract.search</field>
        <field name="model">hr.service.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="user_id"/>
                <filter string="Activos" name="active" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Tipo" name="group_kind" context="{'group_by': 'service_kind'}"/>
                    <filter string="Responsable" name="group_user" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_service_contract" model="ir.actions.act_window">
        <field name="name">Servicios contratados</field>
        <field name="res_model">hr.service.contract</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
