<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_service_payroll_period_wizard_form" model="ir.ui.view">
        <field name="name">hr.service.payroll.period.wizard.form</field>
        <field name="model">hr.service.payroll.period.wizard</field>
        <field name="arch" type="xml">
            <form string="Período de nómina">
                <group>
                    <field name="contract_id"/>
                    <field name="period_date"/>
                </group>
                <footer>
                    <button name="action_create_payroll_project" string="Crear período" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
