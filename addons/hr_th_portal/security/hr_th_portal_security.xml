<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hr_service_contract_portal" model="ir.rule">
        <field name="name">Portal: contratos del cliente</field>
        <field name="model_id" ref="hr_service_management.model_hr_service_contract"/>
        <field name="domain_force">[('partner_id', 'child_of', user.commercial_partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_hr_service_document_portal" model="ir.rule">
        <field name="name">Portal: documentos del cliente</field>
        <field name="model_id" ref="hr_service_management.model_hr_service_document"/>
        <field name="domain_force">['|', '|', ('partner_id', 'child_of', user.commercial_partner_id.ids), ('employee_id.client_partner_id', 'child_of', user.commercial_partner_id.ids), ('project_id.partner_id', 'child_of', user.commercial_partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_hr_ec_payroll_period_portal" model="ir.rule">
        <field name="name">Portal: periodos nómina del cliente</field>
        <field name="model_id" ref="hr_ec_payroll.model_hr_ec_payroll_period"/>
        <field name="domain_force">[('partner_id', 'child_of', user.commercial_partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_project_project_portal_th" model="ir.rule">
        <field name="name">Portal TH: proyectos del cliente</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">['|', ('partner_id', 'child_of', user.commercial_partner_id.ids), ('service_contract_id.partner_id', 'child_of', user.commercial_partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_hr_job_portal_th" model="ir.rule">
        <field name="name">Portal: vacantes del cliente</field>
        <field name="model_id" ref="hr.model_hr_job"/>
        <field name="domain_force">[('client_partner_id', 'child_of', user.commercial_partner_id.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
